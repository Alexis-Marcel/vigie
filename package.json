{
  "name": "vigie",
  "version": "0.1.0",
  "private": true,
  "description": "Modérateur de chat Twitch : règles en français, jugées en temps réel par un modèle de décision. Observe, assiste ou modère.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13 <25"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "vigie": "tsx --tsconfig tsconfig.cli.json --env-file-if-exists=.env src/cli.ts",
    "dev": "vite dev --port 5173",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "start": "node build"
  },
  "dependencies": {
    "yaml": "^2",
    "zod": "^3"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^8.3.3"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
