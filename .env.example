# Clé TypeSafe (Jev). À défaut, une clé OpenRouter fonctionne aussi.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Application Twitch (https://dev.twitch.tv/console/apps), URL de redirection : <origine>/auth/twitch/callback
# Sert à la connexion des modérateurs, aux actions de modération, à la recherche de chaînes et aux métadonnées de live.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Limites du service ouvert (valeurs par défaut si absentes)
VIGIE_MAX_CONCURRENT=20        # observations simultanées sur le serveur
VIGIE_ANON_HOURS=2             # durée maximale d'une observation sans compte
VIGIE_CONNECTED_HOURS=12       # durée maximale pour un modérateur connecté (arrêt 15 min après la fin du live)
VIGIE_DAILY_BUDGET_USD=3       # dépense Jev maximale par jour, toutes chaînes confondues
# VIGIE_DEFAULT_RULES=rules.example.yaml   # jeu de règles proposé à chaque nouvelle chaîne

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=